# Copy this file to ".env" and edit. Never commit the real .env file.

# "mock" = deterministic fake agents (no API key needed). "llm" = real LLM (Milestone 3).
AGENT_MODE=mock

# Used only when AGENT_MODE=llm (added in Milestone 3). Leave blank for now.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
